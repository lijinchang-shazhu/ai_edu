# ============ 大模型配置 ============
# 提供商：deepseek | doubao | openai | qwen | mock
# mock 为离线演示模式（不调用真实 API，使用内置演示内容，保证零翻车）
LLM_PROVIDER=mock

# 大模型 API Key（配置后自动切换为真实智能生成）
LLM_API_KEY=

# 覆盖默认 Base URL（留空则按提供商自动填充）
LLM_BASE_URL=

# 模型名（留空则按提供商自动填充）
LLM_MODEL=

# 生成温度与超时
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# ============ 向量 / Embedding ============
# hash = 本地哈希向量（离线可用，零依赖）；也可配置 openai/doubao/deepseek 在线 Embedding
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
# 跨域来源，逗号分隔，* 表示全部
CORS_ORIGINS=*
